<mvc:View
    controllerName="com.ztkt.assignment.controller.View2"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:micro="sap.suite.ui.microchart"
    displayBlock="true">

    <Page id="pagePerf" showHeader="false" backgroundDesign="Solid">
        <content>
            <VBox id="vbPerfMain" class="dashboardWrapper">

                <!-- ═══ KPI: FINISHED + SLA ═══ -->
                <l:Grid id="gridPerfKpi" hSpacing="1" vSpacing="0" class="kpiGrid">

                    <VBox id="kpiFinished" class="kpiCard kpiAccentGreen">
                        <layoutData><l:GridData id="gdFinished" span="L4 M12 S12"/></layoutData>
                        <HBox id="kpiChipFin" class="kpiIconChip" justifyContent="Center" alignItems="Center">
                            <core:Icon id="kpiIconFin" src="sap-icon://complete"/>
                        </HBox>
                        <Label id="lblFinished" text="Tickets Finished" class="kpiCardLabel"/>
                        <Text id="subFinished" text="total closed" class="kpiCardSub"/>
                        <ObjectStatus id="valFinished" text="{kpi>/finishedTotal}" state="Success" class="kpiCardValue"/>
                        <HBox id="hbFinishedBreakdown" class="sapUiSmallMarginTop">
                            <VBox id="vbFinSup" class="sapUiMediumMarginEnd">
                                <Text id="lblFinSup" text="Support" class="kpiCardSub"/>
                                <ObjectStatus id="valFinSup" text="{kpi>/finishedSup}" state="Information"/>
                            </VBox>
                            <VBox id="vbFinCr" class="sapUiMediumMarginEnd">
                                <Text id="lblFinCr" text="CR" class="kpiCardSub"/>
                                <ObjectStatus id="valFinCr" text="{kpi>/finishedCr}" state="Information"/>
                            </VBox>
                            <VBox id="vbFinAvg">
                                <Text id="lblFinAvg" text="Avg/day" class="kpiCardSub"/>
                                <ObjectStatus id="valFinAvg" text="{kpi>/finishedAvgDay}" state="None"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Panel id="panelSla" width="100%" class="dashboardPanel">
                        <layoutData><l:GridData id="gdSla" span="L8 M12 S12"/></layoutData>
                        <headerToolbar>
                            <Toolbar id="tbSla" class="dashboardPanelToolbar">
                                <HBox id="hbSlaDot" class="panelDot panelDotIndigo"/>
                                <Title id="titleSla" text="SLA Compliance" level="H3"/>
                            </Toolbar>
                        </headerToolbar>
                        <VBox id="vbSla" class="sapUiMediumMargin">
                            <HBox id="hbSlaTop" justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                                <VBox id="vbSlaWithin">
                                    <Text id="lblSlaWithin" text="WITHIN SLA" class="kpiCardSub"/>
                                    <ObjectStatus id="valSlaWithin" text="{kpi>/slaWithinText}" state="Success" class="kpiCardValue"/>
                                </VBox>
                                <VBox id="vbSlaBreach">
                                    <Text id="lblSlaBreach" text="BREACH" class="kpiCardSub"/>
                                    <ObjectStatus id="valSlaBreach" text="{kpi>/slaBreachText}" state="Error" class="kpiCardValue"/>
                                </VBox>
                                <VBox id="vbSlaAvg">
                                    <Text id="lblSlaAvg" text="AVG RESOLUTION&#xA;(SUPPORT ONLY)" class="kpiCardSub multiLineSub"/>
                                    <ObjectStatus id="valSlaAvg" text="{= ${kpi>/slaAvgDays} + ' days'}" state="None" class="kpiCardValue"/>
                                </VBox>
                            </HBox>
                            <ProgressIndicator id="piSla"
                                percentValue="{kpi>/slaWithinPct}"
                                displayValue="{= ${kpi>/slaWithinPct} + '% within SLA'}"
                                state="Success"/>
                        </VBox>
                    </Panel>

                </l:Grid>

                <!-- ═══ TICKETS PER CUSTOMER ═══ -->
                <Panel id="panelCustomer" width="100%" class="sapUiSmallMarginBottom dashboardPanel">
                    <headerToolbar>
                        <Toolbar id="tbCustomer" class="dashboardPanelToolbar">
                            <HBox id="hbCustDot" class="panelDot panelDotSky"/>
                            <Title id="titleCustomer" text="Tickets per Customer" level="H3"/>
                            <ToolbarSpacer id="tsCustomer"/>
                        </Toolbar>
                    </headerToolbar>
                    <Table id="tblCustomer" inset="false" fixedLayout="false" width="100%"
                        sticky="ColumnHeaders" alternateRowColors="false"
                        items="{ path: 'custModel>/items' }">
                        <columns>
                            <Column id="colCustName"><Text id="txtCustName" text="Customer"/></Column>
                            <Column id="colCustSup" hAlign="Center" width="96px" minScreenWidth="Phone" demandPopin="true"><Text id="txtCustSup" text="Support"/></Column>
                            <Column id="colCustCr" hAlign="Center" width="96px" minScreenWidth="Phone" demandPopin="true"><Text id="txtCustCr" text="CR"/></Column>
                            <Column id="colCustTotal" hAlign="Center" width="80px"><Text id="txtCustTotal" text="Total"/></Column>
                            <Column id="colCustBar" minScreenWidth="Tablet" demandPopin="true"><Text id="txtCustBar" text="Distribution"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="cliCustTpl" vAlign="Middle">
                                <cells>
                                    <Text id="txtCustCell" text="{custModel>cust}" class="leaderName"/>
                                    <ObjectStatus id="osCustSup" text="{custModel>sup}" state="Information" inverted="true"/>
                                    <ObjectStatus id="osCustCr" text="{custModel>cr}" state="Warning" inverted="true"/>
                                    <Text id="txtCustTotalCell" text="{custModel>total}" class="leaderTickets"/>
<ProgressIndicator id="piCust"
    percentValue="{custModel>pct}"
    displayValue="{custModel>pctLabel}"
    state="Information"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>
<l:Grid id="gridAnalytics" defaultSpan="L6 M12 S12" hSpacing="1" vSpacing="0" class="sapUiSmallMarginBottom">
 
    <Panel id="panelModule" width="100%" class="dashboardPanel">
        <headerToolbar>
            <Toolbar id="tbModule" class="dashboardPanelToolbar">
                <HBox id="hbModDot" class="panelDot panelDotIndigo"/>
                <Title id="titleModule" text="Tickets per Module" level="H3"/>
                <ToolbarSpacer id="tsModule"/>
                <Text id="subModule" text="busiest first" class="kpiCardSub"/>
            </Toolbar>
        </headerToolbar>
        <VBox id="vbModuleChart" class="chartPad">
            <micro:ColumnMicroChart id="cmcModule"
                size="Responsive"
                height="180px"
                columns="{moduleModel>/items}">
                <micro:columns>
                    <micro:ColumnMicroChartData
                        label="{moduleModel>module}"
                        value="{moduleModel>total}"
                        color="{moduleModel>color}"/>
                </micro:columns>
            </micro:ColumnMicroChart>
            <!-- legend / detail list bawah chart -->
            <HBox id="hbModLegend" wrap="Wrap" class="chartLegend"
                items="{moduleModel>/items}">
                <HBox class="legendItem" alignItems="Center">
                    <Text text="{moduleModel>module}" class="legendLabel"/>
                    <Text text="{moduleModel>total}" class="legendValue"/>
                </HBox>
            </HBox>
        </VBox>
    </Panel>
 
    <!-- ═══ WORKLOAD BALANCE — ticket aktif per consultant ═══ -->
    <Panel id="panelWorkload" width="100%" class="dashboardPanel">
        <headerToolbar>
            <Toolbar id="tbWorkload" class="dashboardPanelToolbar">
                <HBox id="hbWLDot" class="panelDot panelDotRed"/>
                <Title id="titleWorkload" text="Workload Balance" level="H3"/>
                <ToolbarSpacer id="tsWorkload"/>
                <Text id="subWorkload" text="active tickets per consultant" class="kpiCardSub"/>
            </Toolbar>
        </headerToolbar>
        <Table id="tblWorkload" inset="false" fixedLayout="false" width="100%"
            sticky="ColumnHeaders" alternateRowColors="false"
            items="{ path: 'workloadModel>/items' }">
            <columns>
                <Column id="colWLName"><Text id="txtWLName" text="Consultant"/></Column>
                <Column id="colWLActive" hAlign="Center" width="70px"><Text id="txtWLActive" text="Active"/></Column>
                <Column id="colWLBar"><Text id="txtWLBar" text="Load"/></Column>
                <Column id="colWLState" hAlign="Center" width="90px" minScreenWidth="Tablet" demandPopin="true"><Text id="txtWLState" text="Status"/></Column>
            </columns>
            <items>
                <ColumnListItem id="cliWLTpl" vAlign="Middle">
                    <cells>
                        <HBox id="hbWLName" alignItems="Center">
                            <Text id="txtWLInit" text="{workloadModel>initials}" class="initialsChip"/>
                            <Text id="txtWLNameCell" text="{workloadModel>display}" class="leaderName"/>
                        </HBox>
                        <Text id="txtWLActiveCell" text="{workloadModel>active}" class="leaderTickets"/>
                        <ProgressIndicator id="piWL"
                            percentValue="{workloadModel>pct}"
                            displayValue="{workloadModel>active}"
                            state="{workloadModel>state}"/>
                        <ObjectStatus id="osWLState"
                            text="{workloadModel>loadLabel}"
                            state="{workloadModel>state}"
                            inverted="true"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Panel>
 
</l:Grid>
                <!-- ═══ LEADERBOARD ═══ -->
                <Panel id="panelLeader" width="100%" class="dashboardPanel">
                    <headerToolbar>
                        <Toolbar id="tbLeader" class="dashboardPanelToolbar">
                            <HBox id="hbLdDot" class="panelDot panelDotAmber"/>
                            <Title id="titleLeader" text="Consultant Leaderboard" level="H3"/>
                            <ToolbarSpacer id="tsLeader"/>
                            <Text id="subLeader" text="Ranked by total credit points" class="kpiCardSub"/>
                        </Toolbar>
                    </headerToolbar>
                    <Table id="tblLeader" inset="false" fixedLayout="false" width="100%"
                        sticky="ColumnHeaders" alternateRowColors="false"
                        items="{ path: 'leaderModel>/items' }">
                        <columns>
                            <Column id="colLdRank" hAlign="Center" width="64px"><Text id="txtLdRank" text="Rank"/></Column>
                            <Column id="colLdName"><Text id="txtLdName" text="Consultant"/></Column>
                            <Column id="colLdTickets" hAlign="Center" width="100px" minScreenWidth="Phone" demandPopin="true"><Text id="txtLdTickets" text="Tickets"/></Column>
                            <Column id="colLdAvg" hAlign="Center" width="110px" minScreenWidth="Tablet" demandPopin="true"><Text id="txtLdAvg" text="Avg Credit"/></Column>
                            <Column id="colLdTotal" hAlign="End" width="120px"><Text id="txtLdTotal" text="Total Credit"/></Column>
                        </columns>
                        <items>
                            <ColumnListItem id="cliLdTpl" vAlign="Middle">
                                <cells>
                                    <Text id="txtLdRankCell" text="{leaderModel>rank}" class="rankMedal {leaderModel>rankClass}"/>
                                    <HBox id="hbLdName" alignItems="Center">
                                        <Text id="txtLdInit" text="{leaderModel>initials}" class="initialsChip"/>
                                        <Text id="txtLdNameCell" text="{leaderModel>display}" class="leaderName"/>
                                    </HBox>
                                    <Text id="txtLdTicketsCell" text="{leaderModel>tickets}" class="leaderTickets"/>
                                    <Text id="txtLdAvgCell" text="{leaderModel>avgCredit}" class="leaderAvg"/>
                                    <ObjectStatus id="osLdTotal" text="{leaderModel>creditPoints}" state="Warning" class="creditTotal"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </Panel>

            </VBox>
        </content>
    </Page>

</mvc:View>
<mvc:View
    controllerName="com.ztkt.assignment.controller.App"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true">

    <tnt:ToolPage id="toolPage1" sideExpanded="false">

        <tnt:header>
            <tnt:ToolHeader id="toolHeader1">
                <Button id="btnMenu1"
                    icon="sap-icon://menu2"
                    type="Transparent"
                    press="onSideNavButtonPress">
                    <layoutData>
                        <OverflowToolbarLayoutData id="otldMenu1" priority="NeverOverflow"/>
                    </layoutData>
                </Button>
                <Title id="titleApp1" text="Ticket Management" level="H1"/>
                <ToolbarSpacer id="tsHeader1"/>
                <Button id="btnUser1" icon="sap-icon://person-placeholder" type="Transparent"/>
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation id="sideNav1" expanded="false" itemSelect="onItemSelect" selectedKey="assignment">
                <tnt:item>
                    <tnt:NavigationList id="navList1">
                        <tnt:NavigationListItem id="navAssign1" text="Assignment Dashboard" icon="sap-icon://employee" key="assignment"/>
                        <tnt:NavigationListItem id="navPerf" text="Performance Dashboard" icon="sap-icon://business-objects-experience" key="performance"/>
                    </tnt:NavigationList>
                </tnt:item>
                <tnt:fixedItem>
                    <tnt:NavigationList id="navListFixed1">
                        <tnt:NavigationListItem id="navSettings1" text="Settings" icon="sap-icon://action-settings" key="settings"/>
                    </tnt:NavigationList>
                </tnt:fixedItem>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <NavContainer id="navContainer"/>
        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>